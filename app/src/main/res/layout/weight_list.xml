<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    android:id="@+id/weight_card"
    app:strokeColor="#4A4848"
    app:strokeWidth="2dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="0dp"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="20dp"
    android:layout_marginEnd="20dp"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="5dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:padding="5dp"
            android:layout_margin="5dp"
            android:id="@+id/weight_type_img"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
              app:layout_constraintStart_toStartOf="parent"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/todo" />

    <TextView
        android:textStyle="bold"
        android:id="@+id/weight_name_tv"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_margin="5dp"
        android:padding="5dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/weight_type_img"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@id/weight_et"
        android:layout_width="match_parent"
        android:layout_height="40dp"/>

    <EditText
        android:inputType="number"
        android:maxLength="3"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_margin="5dp"
        android:padding="5dp"
        android:id="@+id/weight_et"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/weight_et_g"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:importantForAutofill="no" />

        <EditText
            android:inputType="number"
            android:maxLength="3"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_margin="5dp"
            android:padding="5dp"
            android:id="@+id/weight_et_g"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/weight_update_button"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:importantForAutofill="no" />

        <ImageView
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_margin="5dp"
            android:id="@+id/weight_update_button"
            app:layout_constraintTop_toTopOf="parent"
            android:padding="10dp"
            android:src="@drawable/ic_baseline_check_24"
            app:layout_constraintEnd_toStartOf="@id/weight_delete_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="TODO" />

    <ImageView
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_margin="5dp"
        android:id="@+id/weight_delete_button"
        app:layout_constraintTop_toTopOf="parent"
        android:padding="10dp"
        android:src="@drawable/ic_baseline_clear_24"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="40dp"
        android:layout_height="40dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>