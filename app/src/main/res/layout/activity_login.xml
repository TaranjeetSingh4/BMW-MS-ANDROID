<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activities.LoginActivity">

    <ImageView
        android:id="@+id/login_bottom_img"
        android:scaleType="centerCrop"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_width="match_parent"
        android:layout_height="150dp"/>

    <androidx.core.widget.NestedScrollView
        app:layout_constrainedHeight="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:layout_margin="20dp"
                app:layout_constraintTop_toTopOf="parent"
                android:id="@+id/login_header_img"
                android:layout_width="match_parent"
                android:layout_height="100dp"/>

            <TextView
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_margin="20dp"
                android:text="Bio Medical Waste Management System"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <TextView
                android:textColor="@color/app_color_dark"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:text="Choose account type from CBWTF and HCF"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <com.google.android.material.button.MaterialButton
                android:textStyle="bold"
                android:onClick="onCbwtf"
                android:backgroundTint="@color/app_color_dark"
                android:id="@+id/cbwtf_button"
                android:text="CBWTF Operator Login"
                android:layout_margin="20dp"
                android:layout_width="match_parent"
                android:layout_height="50dp"/>

            <com.google.android.material.button.MaterialButton
                android:textStyle="bold"
                android:onClick="onHcf"
                android:id="@+id/hfc_button"
                android:backgroundTint="@color/app_color_dark"
                android:text="HCF Login"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_width="match_parent"
                android:layout_height="50dp"/>

            <TextView
                android:textColor="@color/black"
                android:id="@+id/guideline_link_tv"
                android:layout_margin="20dp"
                android:visibility="gone"
                android:textStyle="bold"
                android:text="@string/u_guidelines_of_cpcb_and_bmwm_rules_u"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <TextView
                android:layout_marginBottom="20dp"
                android:textColor="@color/black"
                android:id="@+id/youtube_link_tv"
                android:drawablePadding="5dp"
                android:textAlignment="center"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:textStyle="bold"
                android:text="@string/how_it_works"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:drawableTint="@android:color/holo_red_light"
                app:drawableStartCompat="@drawable/ic_baseline_smart_display_24" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>