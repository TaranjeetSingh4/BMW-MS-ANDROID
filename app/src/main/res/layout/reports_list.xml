<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    android:layout_marginBottom="5dp"
    android:layout_marginStart="5dp"
    android:layout_marginEnd="5dp"
    android:layout_marginTop="5dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="5dp"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:gravity="center"
            android:background="#FAFAFA"
            android:orientation="vertical"
            android:layout_marginTop="10dp"
            android:layout_marginStart="10dp"
            android:layout_marginBottom="10dp"
            android:layout_width="60dp"
            android:layout_height="match_parent">


            <ImageView
                android:id="@+id/report_total_waste_packet_img"
                android:layout_margin="10dp"
                android:layout_width="match_parent"
                android:layout_height="30dp"/>

            <TextView
                android:textColor="@color/app_color_dark"
                android:textSize="10sp"
                android:gravity="center"
                android:text="@string/total"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/report_total_waste_packet_tv"
                android:layout_margin="10dp"
                android:textColor="#4A4848"
                android:textStyle="bold"
                android:gravity="center"
                android:text="0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <TextView
                android:visibility="gone"
                android:textStyle="bold"
                android:textSize="50sp"
                android:text="A"
                android:gravity="center"
                android:textColor="@color/app_color"
                android:id="@+id/report_hospital_name_initial"
                android:layout_width="60dp"
                android:layout_height="match_parent"/>

        </LinearLayout>

        <View
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="@color/app_color_dark"
            android:layout_width="1dp"
            android:layout_height="match_parent"/>

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:textStyle="bold"
                android:textColor="@color/app_color_dark"
                android:id="@+id/report_hospital_name"
                android:layout_marginTop="10dp"
                android:text="ABCD Hospital"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <View
                android:layout_marginEnd="10dp"
                android:layout_marginTop="10dp"
                android:background="@color/app_color_dark"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_marginTop="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <TextView
                        android:textColor="@color/app_color_dark"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:text="Hospital Code:"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:textColor="@color/app_color_dark"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:text="HCF Weight:"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/tv_cbwtf_weight"
                        android:textColor="@color/app_color_dark"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:visibility="gone"
                        android:text="CBWTF Weight:"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:textColor="@color/app_color_dark"
                        android:textStyle="bold"
                        android:visibility="gone"
                        android:textSize="12sp"
                        android:text="Difference Weight:"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:textColor="@color/app_color_dark"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:visibility="gone"
                        android:text="HCF Address:\n"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:textColor="@color/app_color_dark"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:text="CBWTF Address:\n"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:layout_marginBottom="10dp"
                        android:textColor="@color/app_color_dark"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:text="Date:"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                </LinearLayout>

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_margin="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/report_hospital_code"
                        android:textColor="#4A4848"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:text="Hospital name:"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/report_hcf_weight"
                        android:textColor="#4A4848"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:text="Hospital name:"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/report_cbwtf_weight"
                        android:textColor="#4A4848"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:visibility="gone"
                        android:text="Hospital name:"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/report_difference_weight"
                        android:textColor="@color/black"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:text="Hospital name:"
                        android:layout_width="wrap_content"
                        android:visibility="gone"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:lines="2"
                        android:maxLines="2"
                        android:id="@+id/report_hcf_address"
                        android:textColor="@color/app_color"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:visibility="gone"
                        android:text="--- --- ---\n"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:lines="2"
                        android:maxLines="2"
                        android:id="@+id/report_cbwtf_address"
                        android:textColor="@color/app_color"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:visibility="gone"
                        android:text="--- --- ---\n"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/report_date"
                        android:textColor="#4A4848"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:text="Hospital name:"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                </LinearLayout>


            </LinearLayout>

            <View
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="10dp"
                android:background="@color/app_color_dark"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>

            <LinearLayout
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="HCF      "
                    android:textColor="#4A4848"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/report_red_iv"
                        android:layout_width="20dp"
                        android:layout_height="20dp"/>

                    <TextView
                        android:id="@+id/report_red_weight"
                        android:textStyle="bold"
                        android:text="0"
                        android:textColor="#4A4848"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                </LinearLayout>

                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/report_blue_iv"
                        android:layout_width="20dp"
                        android:layout_height="20dp"/>

                    <TextView
                        android:id="@+id/report_blue_weight"
                        android:textStyle="bold"
                        android:text="0"
                        android:textColor="#4A4848"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                </LinearLayout>

                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/report_yellow_iv"
                        android:layout_width="20dp"
                        android:layout_height="20dp"/>

                    <TextView
                        android:id="@+id/report_yellow_weight"
                        android:textStyle="bold"
                        android:text="0"
                        android:textColor="#4A4848"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                </LinearLayout>

                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/report_white_iv"
                        android:layout_width="20dp"
                        android:layout_height="20dp"/>

                    <TextView
                        android:id="@+id/report_white_weight"
                        android:textStyle="bold"
                        android:text="0"
                        android:textColor="#4A4848"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp"
                android:orientation="horizontal"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="CBWTF"
                    android:textColor="#4A4848"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/report_red_iv_cbwtf"
                        android:layout_width="20dp"
                        android:layout_height="20dp"/>

                    <TextView
                        android:id="@+id/report_red_weight_cbwtf"
                        android:textStyle="bold"
                        android:text="0"
                        android:textColor="#4A4848"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                </LinearLayout>

                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/report_blue_iv_cbwtf"
                        android:layout_width="20dp"
                        android:layout_height="20dp"/>

                    <TextView
                        android:id="@+id/report_blue_weight_cbwtf"
                        android:textStyle="bold"
                        android:text="0"
                        android:textColor="#4A4848"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                </LinearLayout>

                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/report_yellow_iv_cbwtf"
                        android:layout_width="20dp"
                        android:layout_height="20dp"/>

                    <TextView
                        android:id="@+id/report_yellow_weight_cbwtf"
                        android:textStyle="bold"
                        android:text="0"
                        android:textColor="#4A4848"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                </LinearLayout>

                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/report_white_iv_cbwtf"
                        android:layout_width="20dp"
                        android:layout_height="20dp"/>

                    <TextView
                        android:id="@+id/report_white_weight_cbwtf"
                        android:textStyle="bold"
                        android:text="0"
                        android:textColor="#4A4848"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>