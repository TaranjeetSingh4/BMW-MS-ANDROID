<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".cbwtf.activities.CbwtfDashboardActivity">

    <LinearLayout
        android:gravity="center_vertical"
        android:background="@color/app_color_dark"
        android:id="@+id/cbwtf_dashboard_appbar"
        app:layout_constraintTop_toTopOf="parent"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="?actionBarSize">

        <ImageView
            android:id="@+id/cbwtf_dashboard_header_logo_img"
            android:padding="5dp"
            android:background="@drawable/bg_white_round"
            android:layout_margin="10dp"
            android:layout_width="40dp"
            android:layout_height="40dp"/>

        <TextView
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/cbwtf_dashboard_header_tv"
            android:layout_margin="10dp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"/>

        <ImageView
            app:tint="@color/white"
            android:src="@drawable/ic_baseline_qr_code_scanner_24"
            android:id="@+id/cbwtf_dashboard_header_scan_img"
            android:padding="5dp"
            android:layout_margin="10dp"
            android:layout_width="40dp"
            android:layout_height="40dp"/>


    </LinearLayout>

    <ImageView
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:id="@+id/cbwtf_dashboard_bottom_img"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_width="match_parent"
        android:layout_height="150dp"/>

    <androidx.core.widget.NestedScrollView
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cbwtf_dashboard_appbar"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/cbwtf_header_ll"
                android:orientation="vertical"
                android:background="@drawable/gradient_bg_green"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_width="match_parent"
                android:layout_height="150dp">

                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <LinearLayout
                        android:id="@+id/today_collected_ll"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_margin="10dp"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="match_parent">

                        <TextView
                            android:textStyle="bold"
                            android:gravity="center"
                            android:layout_margin="5dp"
                            android:textColor="@color/white"
                            android:text="Today attempted\nhospitals"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>

                        <LinearLayout
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:id="@+id/cbwtf_dashboard_attempted_tv"
                                android:layout_margin="5dp"
                                android:background="@drawable/bg_white_round"
                                android:text="0"
                                android:textColor="@color/black"
                                android:gravity="center"
                                android:minWidth="25dp"
                                android:layout_width="wrap_content"
                                android:layout_height="30dp"/>

                        </LinearLayout>

                    </LinearLayout>

                    <View
                        android:id="@+id/view_0"
                        android:layout_margin="10dp"
                        android:background="@color/white"
                        android:layout_width="2dp"
                        android:layout_height="50dp"/>

                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_margin="10dp"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="match_parent">

                        <TextView
                            android:textStyle="bold"
                            android:gravity="center"
                            android:layout_margin="5dp"
                            android:textColor="@color/white"
                            android:text="Today waste collected\n"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>

                        <LinearLayout
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:padding="5dp"
                                android:id="@+id/cbwtf_dashboard_waste_collected_tv"
                                android:layout_margin="5dp"
                                android:background="@drawable/bg_white_round"
                                android:text="0"
                                android:textColor="@color/black"
                                android:gravity="center"
                                android:minWidth="25dp"
                                android:layout_width="wrap_content"
                                android:layout_height="30dp"/>

                            <TextView
                                android:textStyle="bold"
                                android:layout_margin="5dp"
                                android:textColor="@color/white"
                                android:text="KG"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cbwtf_dashboard_hcf_scan_card"
                    app:cardElevation="5dp"
                    android:layout_margin="10dp"
                    android:layout_width="100dp"
                    android:layout_height="100dp">

                    <ImageView
                        android:id="@+id/cbwtf_dashboard_hcf_scan_img"
                        android:background="@drawable/gradient_bg_white_green"
                        android:padding="25dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>

                    <TextView
                        android:layout_margin="5dp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:text="HCF Scan"
                        android:layout_gravity="bottom"
                        android:layout_width="match_parent"
                        android:layout_height="20dp"/>


                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cbwtf_dashboard_reports_card"
                    app:cardElevation="5dp"
                    android:layout_margin="10dp"
                    android:layout_width="100dp"
                    android:layout_height="100dp">

                    <ImageView
                        android:id="@+id/cbwtf_dashboard_reports_img"
                        android:background="@drawable/gradient_bg_white_green"
                        android:padding="25dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>

                    <TextView
                        android:layout_margin="5dp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:text="Reports"
                        android:layout_gravity="bottom"
                        android:layout_width="match_parent"
                        android:layout_height="20dp"/>


                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cbwtf_dashboard_rescan_card"
                    app:cardElevation="5dp"
                    android:layout_margin="10dp"
                    android:layout_width="100dp"
                    android:layout_height="100dp">

                    <ImageView
                        android:id="@+id/cbwtf_dashboard_rescan_img"
                        android:background="@drawable/gradient_bg_white_green"
                        android:padding="25dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>

                    <TextView
                        android:layout_margin="5dp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:text="Rescan"
                        android:layout_gravity="bottom"
                        android:layout_width="match_parent"
                        android:layout_height="20dp"/>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cbwtf_dashboard_profile_card"
                    app:cardElevation="5dp"
                    android:layout_margin="10dp"
                    android:layout_width="100dp"
                    android:layout_height="100dp">

                    <ImageView
                        android:id="@+id/cbwtf_dashboard_profile_img"
                        android:background="@drawable/gradient_bg_white_green"
                        android:padding="25dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>

                    <TextView
                        android:layout_margin="5dp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:text="Profile"
                        android:layout_gravity="bottom"
                        android:layout_width="match_parent"
                        android:layout_height="20dp"/>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:visibility="gone"
                    android:id="@+id/cbwtf_dashboard_logout_card"
                    app:cardElevation="5dp"
                    android:layout_margin="10dp"
                    android:layout_width="100dp"
                    android:layout_height="100dp">

                    <ImageView
                        android:id="@+id/cbwtf_dashboard_logout_img"
                        android:background="@drawable/gradient_bg_white_green"
                        android:padding="25dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>

                    <TextView
                        android:layout_margin="5dp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:text="Logout"
                        android:layout_gravity="bottom"
                        android:layout_width="match_parent"
                        android:layout_height="20dp"/>


                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <LinearLayout
                android:visibility="gone"
                android:layout_margin="10dp"
                android:background="@drawable/bg_et"
                android:orientation="vertical"
                android:id="@+id/otp_ll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:textColor="@color/app_color_dark"
                    android:textStyle="bold"
                    android:layout_margin="10dp"
                    android:gravity="center"
                    android:text="OTP FOR CBWTF OPERATOR"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/otp_tv"
                    android:textColor="@color/app_color"
                    android:textStyle="bold"
                    android:textSize="30sp"
                    android:gravity="center"
                    android:text="- - - -"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:textColor="@color/app_color_dark"
                    android:textStyle="bold"
                    android:layout_margin="10dp"
                    android:gravity="center"
                    android:text="Valid for today"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

            </LinearLayout>

            <TextView
                android:textColor="@color/black"
                android:id="@+id/cbwtf_dashboard_guideline_link_tv"
                android:layout_marginTop="10dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:textStyle="bold"
                android:visibility="gone"
                android:text="@string/u_guidelines_of_cpcb_and_bmwm_rules_u"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <TextView
                android:textColor="@color/black"
                android:id="@+id/cbwtf_dashboard_youtube_link_tv"
                android:drawablePadding="5dp"
                android:textAlignment="center"
                android:layout_margin="20dp"
                android:textStyle="bold"
                android:text="@string/how_it_works"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:drawableTint="@android:color/holo_red_light"
                app:drawableStartCompat="@drawable/ic_baseline_smart_display_24" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>